{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/sync-pull.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" .codex/hooks/sync-pull.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/clear-nudge.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" .codex/hooks/clear-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/sync-push.sh",
            "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" .codex/hooks/sync-push.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
